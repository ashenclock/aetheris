# Copy to .env locally; never commit the real file.
AETHERIS_MODEL=ollama/llama3
# Optional smaller tool schema for local models: default or local-coding.
AETHERIS_TOOL_PROFILE=default
# For the hosted OpenAI Responses adapter, use: responses/codex-mini-latest
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AETHERIS_API_TOKEN=<set-locally>
N8N_ENCRYPTION_KEY=<set-locally>
AETHERIS_WORKSPACE=./workspace
# Workspace-defined MCP servers start only after explicit opt-in.
AETHERIS_ENABLE_MCP=0
# auto uses the configured backend or DuckDuckGo; Brave requires explicit selection.
AETHERIS_SEARCH_BACKEND=auto
BRAVE_SEARCH_API_KEY=

# Child sessions inherit AETHERIS_MODEL unless a cheaper local model is set.
# Example: ollama/llama3.2:3b
AETHERIS_SUBAGENT_MODEL=
# Total reservation shared by all children of one parent task.
AETHERIS_SUBAGENT_BUDGET_USD=0.25
AETHERIS_MAX_SUBAGENTS=2
# Approximate parent context character budget; children use at most 12000.
AETHERIS_CONTEXT_CHARS=24000
# Maximum output tokens per model request; this is not a total spend limit.
AETHERIS_MAX_COMPLETION_TOKENS=4096
AETHERIS_MODEL_TIMEOUT_SECONDS=120
